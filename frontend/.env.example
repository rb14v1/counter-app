# counterapp — environment variable reference
# Copy this file to .env for local development (never commit .env).
# All variables are read at runtime from the process environment.

# Port the HTTP server listens on (default: 3000)
PORT=

# Node runtime environment: development | production | test
NODE_ENV=

# Full URL of the counter API consumed by the frontend. It is read at build time.
# Example: VITE_API_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api
